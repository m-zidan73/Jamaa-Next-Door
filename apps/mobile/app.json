{
  "expo": {
    "name": "Jamaa Next Door",
    "slug": "zidan",
    "version": "0.1.0",
    "scheme": "jnd",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-location",
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "package": "com.zidan73.jamaanextdoor",
      "versionCode": 5,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "94bfe684-ec4c-46ea-90d6-ac04669b7817"
      }
    },
    "owner": "zidan73s-team"
  }
}
